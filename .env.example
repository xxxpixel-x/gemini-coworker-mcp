# --- Transport & Network ---
# Transport mode when not overridden by --stdio or --http CLI flag: stdio | http
MCP_TRANSPORT=http
HOST=127.0.0.1
PORT=8787

# Public HTTPS origin when exposed via Cloudflare Tunnel / reverse proxy (enables OAuth discovery URLs)
# Example: https://mcp.yourdomain.com
PUBLIC_DOMAIN=http://127.0.0.1:8787

# --- Authentication ---
# Auth mode for HTTP /mcp endpoint:
#   none   - No auth (ONLY allowed when HOST is 127.0.0.1 / localhost)
#   bearer - Static Authorization: Bearer <MCP_BEARER_TOKEN>
#   oauth  - Full Gemini-compatible OAuth 2.1 + PKCE S256 + DCR + RFC 8707/9728
AUTH_MODE=none

# Required when AUTH_MODE=bearer (min 24 chars recommended)
MCP_BEARER_TOKEN=

# Required when AUTH_MODE=oauth
# Generate secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_SIGNING_SECRET=
# Generate hash:   node -e "const c=require('node:crypto'),s=c.randomBytes(16).toString('hex');console.log('scrypt:'+s+':'+c.scryptSync(process.argv[1],s,32,{N:16384,r:8,p:1}).toString('hex'))" "your-password"
ADMIN_PASSWORD_HASH=
OAUTH_ALLOWED_REDIRECT_HOSTS=gemini.google.com,aistudio.google.com,accounts.google.com,claude.ai,chatgpt.com
OAUTH_STATIC_CLIENT_ID=
OAUTH_STATIC_CLIENT_SECRET=
OAUTH_ACCESS_TOKEN_TTL_SEC=3600
OAUTH_REFRESH_TOKEN_TTL_SEC=2592000
OAUTH_REFRESH_GRACE_SEC=60
TRUST_CF_CONNECTING_IP=false

# --- Storage & Workspaces ---
# Shared SQLite database and artifacts. An empty value uses the installation directory/.data.
DATA_DIR=
# Comma-separated absolute directories allowed for workspaces and text attachments.
# Leave empty to default to the current working directory.
ALLOWED_WORKSPACE_ROOTS=

# --- Tool Profile & Gemini UX ---
# full        - Expose all 14 tools (Gemini hub + workspace/agent/desktop/GitHub)
# gemini_only - Expose ONLY the 5 Gemini desktop/history tools (recommended for Antigravity, Codex, Claude Code)
TOOL_PROFILE=full
# Legacy sandbox tool hints. Desktop task, chat and review retain their external-action annotations.
# so Gemini Connected Apps won't ignore "Always Allow" and spam confirmation dialogs.
MCP_TRUST_SANDBOX_HINTS=true
INLINE_OUTPUT_MAX_BYTES=60000

# --- Multi-Agent Runner & Gemini Capability Hub ---
# Default agent driver: codex | claude_code | opencode
DEFAULT_AGENT_DRIVER=codex
AGENT_MAX_DURATION_SEC=600
# Optional provider keys passed ONLY to the matching agent driver (never to workspace_exec)
OPENAI_API_KEY=
CODEX_API_KEY=
ANTHROPIC_API_KEY=
# --- Desktop Automation ---
# Enable desktop_control tool (clipboard, windows list, notifications, open_target)
ENABLE_DESKTOP_CONTROL=true
# Use isolated for a dedicated Gemini on a separate Win32 desktop.
GEMINI_DESKTOP_MODE=interactive
# Allow desktop_control(action="run_powershell") — disabled by default for safety
ENABLE_DESKTOP_POWERSHELL=false

# --- GitHub Integration ---
# Optional GitHub PAT (if empty, github_inspect / publish_changes fall back to local `gh` CLI auth)
GH_TOKEN=
